{
  "name": "arismanager",
  "version": "1.1.0",
  "main": "src/main.js",
  "scripts": {
    "start": "electron ./",
    "build": "electron-builder"
  },
  "repository": "https://github.com/razanadahy/GitIRM",
  "publish": {
    "provider": "github",
    "releaseType": "release"
  },
  "build": {
    "appId": "app.aris.manager",
    "productName": "ARISManager",
    "win": {
      "target": [
        {
