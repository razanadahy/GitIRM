          "arch": ["x64"]
        }
      ],
      "icon": "src/icon.ico"
    }
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "canvas": "^3.1.0",
    "electron-updater": "^6.2.1",
    "node-notifier": "^10.0.1",
    "winreg": "^1.2.5"
  },
  "keywords": [],
  "author": "Andrianiavo",
  "description": "",
  "devDependencies": {
    "concurrently": "^8.2.2",
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3",
    "electron-is-dev": "^3.0.1",
    "electron-rebuild": "^3.2.9",
    "electron-wix-msi": "^5.1.3"
  }
