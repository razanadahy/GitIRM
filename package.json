{
  "name": "arismanager",
  "version": "1.1.0",
  "main": "src/main.js",
  "scripts": {
    "start": "electron ./",
    "build": "electron-builder"
  },
  "repository": "https://github.com/razanadahy/GitIRM",
  "publish": {
    "provider": "github",
    "releaseType": "release"
  },
  "build": {
    "appId": "app.aris.manager",
    "productName": "ARISManager",
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "src/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "installerIcon": "src/icon.ico",
      "uninstallDisplayName": "arisManager_uninstaller",
      "license": "license.md",
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    }
  },
  "dependencies": {
    "auto-launch": "^5.0.6",
    "canvas": "^3.1.0",
    "electron-log": "^5.1.7",
    "electron-store": "^10.0.0",
    "electron-updater": "^6.2.1",
    "node-notifier": "^10.0.1",
    "winreg": "^1.2.5"
  },
  "keywords": [],
  "author": "Andrianiavo",
  "description": "",
  "devDependencies": {
    "concurrently": "^8.2.2",
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3",
    "electron-is-dev": "^3.0.1",
    "electron-rebuild": "^3.2.9",
    "electron-store": "^10.0.0",
    "electron-wix-msi": "^5.1.3"
  }
}
